# Clave de organización para la IA INCLUIDA (no BYOK). Mantenla en secreto.
ANTHROPIC_KEY=sk-ant-...

# Secreto para firmar los tokens de sesión (cámbialo por algo largo y aleatorio).
JWT_SECRET=cambia-esto-por-un-secreto-largo

# % de mantenimiento sobre el uso de la IA incluida (0.15 = 15%).
MARKUP=0.15

# Límite de llamadas/hora por usuario (IA incluida) para proteger la clave.
RATE_LIMIT_HOUR=120

# IDs de cliente para verificar el inicio de sesión nativo (móvil).
# Apple: el Bundle ID de la app iOS (o el Service ID). Google: el OAuth Client ID.
APPLE_CLIENT_ID=com.tuempresa.sintonia
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Permite /auth/dev (login por email sin verificar) SOLO para pruebas. 0 en producción.
ALLOW_DEV_AUTH=1

# Ruta del fichero SQLite y puerto.
DB_PATH=sintonia.db
PORT=8787

# Exigir suscripción activa para la IA incluida (BYOK siempre permitido). 0 = desactivar en dev.
REQUIRE_SUBSCRIPTION=1

# --- Stripe (cobro web/escritorio/Android sin tienda) ---
STRIPE_SECRET=sk_live_o_test_...
STRIPE_PRICE_ID=price_...                 # id del precio de la suscripción mensual
STRIPE_WEBHOOK_SECRET=whsec_...           # del endpoint de webhook en Stripe
APP_BASE_URL=https://sintonia.app         # para success/cancel del checkout

# --- App Store (iOS) ---
APPLE_SHARED_SECRET=                       # App-Specific Shared Secret (suscripciones auto-renovables)

# --- Google Play (Android) ---
GOOGLE_PACKAGE_NAME=com.tuempresa.sintonia
GOOGLE_SERVICE_ACCOUNT_JSON=               # JSON (en una línea) de la cuenta de servicio con acceso a Android Publisher

# --- Reconocimiento ambiente (estilo Shazam) ---
AUDD_TOKEN=                                 # clave de AudD (api.audd.io) para /recognize

# --- Producción / límites ---
NODE_ENV=production                         # obliga JWT_SECRET fuerte
FREE_TIER_CALLS=10                          # comentarios gratis antes de pedir plan
DAILY_CAP=200                               # tope diario de comentarios por usuario
RECOGNIZE_LIMIT_HOUR=60                      # tope de reconocimientos/hora por usuario
